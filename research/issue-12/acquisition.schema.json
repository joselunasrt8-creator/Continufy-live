{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continufy.invalid/research/issue-12/acquisition.schema.json",
  "title": "Issue 12 paid-pilot acquisition record",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "synthetic", "candidate_id", "acquisition_channel", "first_identified_at", "eligibility_basis", "offer", "accepted_scope", "source_authority", "permissions", "response_state", "withdrawal_cancellation", "unresolved_dependencies", "evidence", "transition_determination"],
  "properties": {
    "protocol_id": {"const": "continufy-ai-content-paid-pilot-v1.0.0"},
    "synthetic": {"type": "boolean"},
    "candidate_id": {"type": "string", "minLength": 1},
    "acquisition_channel": {"enum": ["REFERRAL", "EXISTING_RELATIONSHIP", "INBOUND", "MARKETPLACE", "MANUAL_OUTBOUND", "OTHER_MANUAL"]},
    "first_identified_at": {"type": "string", "format": "date-time"},
    "eligibility_basis": {"type": "array", "uniqueItems": true, "items": {"enum": ["HAS_ELIGIBLE_SOURCE", "LEGITIMATE_SOURCE_AUTHORITY", "COMPLETE_RETRIEVABLE_SOURCE", "INTENDED_DISTRIBUTION", "AUTHORIZED_APPROVER_IDENTIFIED", "PUBLICATION_CONTROLLER_IDENTIFIED", "OUTCOME_ACCESS_AVAILABLE"]}},
    "offer": {"type": "object", "additionalProperties": false, "required": ["presented_at", "description_ref", "currency", "proposed_price", "accepted_price", "accepted_at", "service_agreement_ref", "settled_amount", "payment_settlement_ref"], "properties": {"presented_at": {"type": ["string", "null"], "format": "date-time"}, "description_ref": {"type": ["string", "null"]}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "proposed_price": {"type": ["number", "null"], "minimum": 0}, "accepted_price": {"type": ["number", "null"], "minimum": 0}, "accepted_at": {"type": ["string", "null"], "format": "date-time"}, "service_agreement_ref": {"type": ["string", "null"]}, "settled_amount": {"type": ["number", "null"], "minimum": 0}, "payment_settlement_ref": {"type": ["string", "null"]}}},
    "accepted_scope": {"type": ["object", "null"], "additionalProperties": false, "required": ["source_id", "source_type", "asset_count", "forms", "destinations", "revision_limit", "baseline_method", "ready_at", "approver_id", "publication_controller_id"], "properties": {"source_id": {"type": "string"}, "source_type": {"enum": ["recording", "livestream_recording", "webinar", "podcast", "interview", "presentation", "subject_matter_session"]}, "asset_count": {"type": "integer", "minimum": 1, "maximum": 8}, "forms": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["short_form_video", "long_form_video", "written", "title", "thumbnail", "caption"]}}, "destinations": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}}, "revision_limit": {"const": 2}, "baseline_method": {"type": "string", "minLength": 1}, "ready_at": {"type": ["string", "null"], "format": "date-time"}, "approver_id": {"type": "string", "minLength": 1}, "publication_controller_id": {"type": "string", "minLength": 1}}},
    "source_authority": {"type": "object", "additionalProperties": false, "required": ["basis", "complete", "retrievable", "selected_before_outcomes", "authority_ref"], "properties": {"basis": {"enum": ["NOT_VERIFIED", "CUSTOMER_OWNED", "LEGITIMATELY_LICENSED"]}, "complete": {"type": "boolean"}, "retrievable": {"type": "boolean"}, "selected_before_outcomes": {"type": "boolean"}, "authority_ref": {"type": ["string", "null"]}}},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["creation", "evidence_retention", "measurement_data_access", "publication"], "properties": {"creation": {"$ref": "#/$defs/permission"}, "evidence_retention": {"$ref": "#/$defs/permission"}, "measurement_data_access": {"$ref": "#/$defs/permission"}, "publication": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["destination", "mode", "permission_ref"], "properties": {"destination": {"type": "string"}, "mode": {"enum": ["NOT_AUTHORIZED", "CUSTOMER_PUBLISHES", "PROVIDER_MANUAL_PUBLISH"]}, "permission_ref": {"type": ["string", "null"]}}}}}},
    "response_state": {"enum": ["NOT_CONTACTED", "CONTACTED", "NO_RESPONSE", "INTERESTED", "OFFER_PRESENTED", "DECLINED", "ACCEPTED_UNPAID", "PAID", "INELIGIBLE", "WITHDRAWN", "CANCELLED"]},
    "withdrawal_cancellation": {"type": "object", "additionalProperties": false, "required": ["status", "at", "reason_ref"], "properties": {"status": {"enum": ["NONE", "WITHDRAWN", "CANCELLED"]}, "at": {"type": ["string", "null"], "format": "date-time"}, "reason_ref": {"type": ["string", "null"]}}},
    "unresolved_dependencies": {"type": "array", "uniqueItems": true, "items": {"enum": ["SOURCE_AUTHORITY", "SOURCE_ACCESS", "CREATION_PERMISSION", "EVIDENCE_RETENTION_PERMISSION", "PUBLICATION_AUTHORITY", "MEASUREMENT_PERMISSION", "DATA_ACCESS", "APPROVER", "PUBLICATION_CONTROLLER", "SCOPE", "PAYMENT", "PRIVACY", "CREDENTIAL", "PLATFORM_POLICY"]}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "reference", "controlled_storage", "scope"], "properties": {"type": {"enum": ["IDENTIFICATION", "ELIGIBILITY", "OFFER", "SERVICE_AGREEMENT", "PAYMENT_SETTLEMENT", "SOURCE_AUTHORITY", "CREATION_PERMISSION", "EVIDENCE_RETENTION_PERMISSION", "PUBLICATION_PERMISSION", "MEASUREMENT_PERMISSION", "DATA_ACCESS", "WITHDRAWAL_CANCELLATION"]}, "reference": {"type": "string", "minLength": 1}, "controlled_storage": {"const": true}, "scope": {"type": "string", "minLength": 1}}}},
    "transition_determination": {"enum": ["PAID_PILOT_CUSTOMER_ELIGIBLE", "NO_ELIGIBLE_PAID_PILOT_CUSTOMER_ACQUIRED", "BLOCKED_BY_AUTHORITY_OR_ACCESS", "MANUAL_ACQUISITION_REQUIRED"]}
  },
  "$defs": {"permission": {"type": "object", "additionalProperties": false, "required": ["status", "permission_ref"], "properties": {"status": {"enum": ["NOT_REQUESTED", "NOT_GRANTED", "GRANTED", "REVOKED"]}, "permission_ref": {"type": ["string", "null"]}}}}
}
