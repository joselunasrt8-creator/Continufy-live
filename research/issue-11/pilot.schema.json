{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continufy.invalid/research/issue-11/pilot.schema.json",
  "title": "Continufy AI-assisted paid pilot record v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "synthetic", "pilot_id", "customer_id", "execution_gate", "source", "scope", "price", "publication_authorities", "assets", "costs", "outcomes", "usefulness", "continuation", "claims", "privacy", "pilot_status"],
  "properties": {
    "protocol_id": {"const": "continufy-ai-content-paid-pilot-v1.0.0"},
    "synthetic": {"type": "boolean"},
    "pilot_id": {"type": "string"},
    "customer_id": {"type": "string"},
    "execution_gate": {"type": "object", "additionalProperties": false, "required": ["service_agreement_ref", "source_permission_ref", "observation_consent_ref", "scope_frozen", "approver_id", "publication_controller_id", "payment_settlement_ref", "dependencies_satisfied"], "properties": {"service_agreement_ref": {"type": ["string", "null"]}, "source_permission_ref": {"type": ["string", "null"]}, "observation_consent_ref": {"type": ["string", "null"]}, "scope_frozen": {"type": "boolean"}, "approver_id": {"type": ["string", "null"]}, "publication_controller_id": {"type": ["string", "null"]}, "payment_settlement_ref": {"type": ["string", "null"]}, "dependencies_satisfied": {"type": "boolean"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "type", "sha256", "ownership_basis", "eligible"], "properties": {"source_id": {"type": "string"}, "type": {"enum": ["recording", "livestream_recording", "webinar", "podcast", "interview", "presentation", "subject_matter_session"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ownership_basis": {"enum": ["customer_owned", "licensed"]}, "eligible": {"type": "boolean"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["asset_count", "forms", "destinations", "revision_limit", "ready_at"], "properties": {"asset_count": {"type": "integer", "minimum": 1, "maximum": 8}, "forms": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["short_form_video", "long_form_video", "written", "title", "thumbnail", "caption"]}}, "destinations": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}}, "revision_limit": {"const": 2}, "ready_at": {"type": "string", "format": "date-time"}}},
    "price": {"type": "object", "additionalProperties": false, "required": ["currency", "proposed", "invoice", "settled", "refund", "net_paid"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "proposed": {"type": "number", "minimum": 0}, "invoice": {"type": "number", "minimum": 0}, "settled": {"type": "number", "minimum": 0}, "refund": {"type": "number", "minimum": 0}, "net_paid": {"type": "number"}}},
    "publication_authorities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["destination", "mode", "authority_ref"], "properties": {"destination": {"type": "string"}, "mode": {"enum": ["not_authorized", "customer_publishes", "provider_manual_publish"]}, "authority_ref": {"type": ["string", "null"]}}}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "costs": {"type": "object", "additionalProperties": false, "required": ["loaded_hourly_rate", "labor", "ai_api", "contractor", "media", "platform", "direct_cost_total", "approved_asset_count", "cost_per_delivered_asset"], "properties": {"loaded_hourly_rate": {"type": "number", "minimum": 0}, "labor": {"type": "number", "minimum": 0}, "ai_api": {"type": "number", "minimum": 0}, "contractor": {"type": "number", "minimum": 0}, "media": {"type": "number", "minimum": 0}, "platform": {"type": "number", "minimum": 0}, "direct_cost_total": {"type": "number", "minimum": 0}, "approved_asset_count": {"type": "integer", "minimum": 0}, "cost_per_delivered_asset": {"type": ["number", "null"], "minimum": 0}}},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
    "usefulness": {"type": "object", "additionalProperties": false, "required": ["output_usability", "brand_fit", "time_saved", "overall", "accepted"], "properties": {"output_usability": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "brand_fit": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "time_saved": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "overall": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "accepted": {"type": ["boolean", "null"]}}},
    "continuation": {"type": "object", "additionalProperties": false, "required": ["decision", "follow_on_settled", "payment_ref"], "properties": {"decision": {"enum": ["paid_follow_on_settled", "offered_not_paid", "declined", "undecided", "not_observed"]}, "follow_on_settled": {"type": "number", "minimum": 0}, "payment_ref": {"type": ["string", "null"]}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["ai_usage_proves_value", "content_volume_proves_outcome", "views_are_revenue", "correlation_is_attribution", "usefulness_is_causal_lift", "pilot_authorizes_product"], "properties": {"ai_usage_proves_value": {"const": false}, "content_volume_proves_outcome": {"const": false}, "views_are_revenue": {"const": false}, "correlation_is_attribution": {"const": false}, "usefulness_is_causal_lift": {"const": false}, "pilot_authorizes_product": {"const": false}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["retention_deadline", "access_owner_id", "deletion_status", "credentials_stored", "customer_data_in_repository"], "properties": {"retention_deadline": {"type": "string", "format": "date-time"}, "access_owner_id": {"type": "string"}, "deletion_status": {"enum": ["scheduled", "deleted"]}, "credentials_stored": {"const": false}, "customer_data_in_repository": {"const": false}}},
    "pilot_status": {"enum": ["not_started", "active", "completed", "cancelled", "failed", "stopped_governance"]}
  },
  "$defs": {
    "interval": {"type": "object", "additionalProperties": false, "required": ["kind", "start", "end"], "properties": {"kind": {"enum": ["active_labor", "waiting", "approval", "rework"]}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["name", "status", "classification", "actor_id", "intervals"], "properties": {"name": {"type": "string"}, "status": {"enum": ["performed", "not_required", "not_reached"]}, "classification": {"enum": ["human", "ai_assisted", "ai_executed_human_reviewed", "not_applicable"]}, "actor_id": {"type": ["string", "null"]}, "intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["asset_id", "form", "status", "stages", "active_minutes", "waiting_minutes", "approval_minutes", "rework_minutes", "published", "destination", "publication_authority_ref"], "properties": {"asset_id": {"type": "string"}, "form": {"enum": ["short_form_video", "long_form_video", "written", "title", "thumbnail", "caption"]}, "status": {"enum": ["approved", "rejected", "failed", "cancelled"]}, "stages": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/stage"}}, "active_minutes": {"type": "number", "minimum": 0}, "waiting_minutes": {"type": "number", "minimum": 0}, "approval_minutes": {"type": "number", "minimum": 0}, "rework_minutes": {"type": "number", "minimum": 0}, "published": {"type": "boolean"}, "destination": {"type": ["string", "null"]}, "publication_authority_ref": {"type": ["string", "null"]}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["asset_id", "window", "metric", "value", "missing_reason", "evidence_ref", "attribution", "claimed_as_revenue"], "properties": {"asset_id": {"type": "string"}, "window": {"enum": ["24h", "7d", "30d"]}, "metric": {"enum": ["views", "retention_percent", "retention_seconds", "clicks", "leads", "sales", "net_revenue"]}, "value": {"type": ["number", "null"], "minimum": 0}, "missing_reason": {"type": ["string", "null"], "enum": [null, "not_applicable", "not_authorized", "not_available_from_platform", "not_observed", "customer_declined", "evidence_lost", "window_not_elapsed"]}, "evidence_ref": {"type": ["string", "null"]}, "attribution": {"enum": ["not_applicable", "deterministic", "ambiguous_multi_touch", "self_report_only", "unattributed"]}, "claimed_as_revenue": {"type": "boolean"}}}
  }
}
